{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // 共通設定と自動マージは ochanuco/.github の preset（README を参照）
  extends: ['github>ochanuco/.github', 'github>ochanuco/.github:automerge'],
  customManagers: [
    {
      customType: 'jsonata',
      fileFormat: 'toml',
      managerFilePatterns: ['/^manifests/worker-nodes\\.toml$/'],
      matchStrings: [
        'comfyui.{ "depName": "comfyanonymous/ComfyUI", "currentValue": tag }',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'jsonata',
      fileFormat: 'toml',
      managerFilePatterns: ['/^manifests/worker-nodes\\.toml$/'],
      matchStrings: [
        'node.{ "depName": name, "packageName": repo, "currentDigest": commit }',
      ],
      datasourceTemplate: 'git-refs',
    },
  ],
  packageRules: [
    {
      // 上げる前に bust の canary を通す
      matchFileNames: ['manifests/worker-nodes.toml'],
      groupName: 'ComfyUI',
      automerge: false,
    },
  ],
}
