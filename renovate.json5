{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // 共通設定と自動マージは ochanuco/.github の preset（README を参照）
  extends: ['github>ochanuco/.github', 'github>ochanuco/.github:automerge'],
  customDatasources: {
    civitai: {
      defaultRegistryUrlTemplate: 'https://civitai.com/api/v1/models/{{packageName}}',
      transformTemplates: [
        '{"homepage": "https://civitai.com/models/" & $string(id), "releases": modelVersions[status = "Published"].{"version": $string(id) & " # " & name, "releaseTimestamp": publishedAt}}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'jsonata',
      fileFormat: 'toml',
      managerFilePatterns: ['/^manifests/worker-nodes\\.toml$/'],
      matchStrings: [
        'comfyui.{ "depName": "comfyanonymous/ComfyUI", "currentValue": tag }',
      ],
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'jsonata',
      fileFormat: 'toml',
      managerFilePatterns: ['/^manifests/worker-nodes\\.toml$/'],
      matchStrings: [
        'node.{ "depName": name, "packageName": repo, "currentDigest": commit }',
      ],
      datasourceTemplate: 'git-refs',
    },
    {
      // 同じ repo と commit の entry は 1 つの依存にまとめる
      customType: 'jsonata',
      fileFormat: 'toml',
      managerFilePatterns: ['/^manifests/worker-models\\.toml$/'],
      matchStrings: [
        '$distinct(model[repo].{ "depName": repo, "packageName": "https://huggingface.co/" & repo, "currentValue": "main", "currentDigest": revision })',
      ],
      datasourceTemplate: 'git-refs',
    },
    {
      // civitai_version は "<version id> # <版の名前>" をまとめて 1 つの版として書き換える
      customType: 'regex',
      managerFilePatterns: ['/^manifests/worker-models\\.toml$/'],
      matchStrings: [
        'dest = "(?<depName>[^"]+)"\\s+civitai_model = (?<packageName>\\d+)\\s+civitai_version = (?<currentValue>\\d+ # [^\\n]+)',
      ],
      datasourceTemplate: 'custom.civitai',
      versioningTemplate: 'regex:^(?<major>\\d+) ',
    },
  ],
  packageRules: [
    {
      // 上げる前に bust の canary を通す
      matchFileNames: ['manifests/worker-nodes.toml'],
      groupName: 'ComfyUI',
      automerge: false,
    },
    {
      // version id は版の番号ではないので major の差に上限をかけない。PR は 1 モデルずつ
      matchDatasources: ['custom.civitai'],
      maxMajorIncrement: 0,
      groupName: null,
      automerge: false,
    },
    {
      matchFileNames: ['manifests/worker-models.toml'],
      matchDatasources: ['git-refs'],
      groupName: 'Hugging Face models',
      automerge: false,
    },
    {
      matchDepNames: ['diffusion_models/silvermoon-turbo.safetensors'],
      allowedVersions: '/ # .*2\\.9B.*Turbo/',
    },
  ],
}
